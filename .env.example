# Скопируйте в .env и поправьте под своё окружение.

# Базовый путь API. По умолчанию /api/v1 — как в спеке.
VITE_API_BASE_URL=/api/v1

# Мок-сервер (MSW). true/не задано — приложение работает без бэкенда.
# false — запросы идут на настоящий Yii2.
VITE_ENABLE_MOCKS=true

# Адрес реального бэкенда для dev-прокси. Задавайте вместе с
# VITE_ENABLE_MOCKS=false, чтобы обойти CORS в разработке.
# VITE_API_PROXY_TARGET=http://localhost:8080
